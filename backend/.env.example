# Server settings
PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL)
# Used by Prisma to connect to the PostgreSQL instance
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/task_tracker?schema=public"

# Redis cache configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET="supersecretaccesskeyfornxtwavetasktrackerapi123!"
JWT_REFRESH_SECRET="supersecretrefreshkeyfornxtwavetasktrackerapi123!"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
